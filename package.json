{
  "name": "dsh-postgres-backends",
  "description": "PostgreSQL durable backend family for DeepSeek Harness — session persistence today, more backends (settings, …) to come. Includes a Settings console for connection config and bidirectional session migration (JSONL ⇄ PostgreSQL). Third-party, does not modify the Harness source tree.",
  "version": "0.1.0-beta.12",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./console": {
      "types": "./lib/types/console/host.d.ts",
      "default": "./lib/console/host.js"
    },
    "./client": {
      "types": "./lib/types/console/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./storage": {
      "types": "./lib/types/storage/index.d.ts",
      "default": "./lib/storage/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/schema.js",
    "lib/invariant.js",
    "lib/console/*.js",
    "lib/storage/*.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weisanju/dsh-postgres-backends.git"
  },
  "homepage": "https://github.com/weisanju/dsh-postgres-backends",
  "bugs": {
    "url": "https://github.com/weisanju/dsh-postgres-backends/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "postgresql",
    "session",
    "persistence",
    "session-persistence"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session-persistence-jsonl": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-storage": "^0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1",
    "pg": "^8.23.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session-persistence": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-storage": "^0.1.0-rc.7"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session-persistence": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session-persistence-jsonl": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-storage": "^0.1.0-rc.7",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "lightningcss": "^1.33.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.14",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "build:host": "tsc -p tsconfig.json",
    "bundle": "tsdown",
    "watch": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "prepublishOnly": "tsc -p tsconfig.json && tsdown"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  }
}
